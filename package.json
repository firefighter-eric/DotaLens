{
  "name": "dotalens",
  "version": "0.1.0",
  "description": "A bilingual, privacy-conscious Dota 2 analytics dashboard powered by OpenDota.",
  "private": true,
  "license": "MIT",
  "author": "DotaLens contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firefighter-eric/DotaLens.git"
  },
  "bugs": {
    "url": "https://github.com/firefighter-eric/DotaLens/issues"
  },
  "homepage": "https://github.com/firefighter-eric/DotaLens#readme",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:budget": "node scripts/checkBudgets.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "check": "npm run lint && npm run test && npm run build && npm run check:budget",
    "sync:heroes": "node scripts/syncHeroes.mjs",
    "sync:items": "node scripts/syncItems.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.10.0",
    "jsdom": "^30.0.1",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
